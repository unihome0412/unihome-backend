{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "",
    "DatabaseName": "",
    "ServerSelectionTimeoutSeconds": 5
  },
  "Jwt": {
    "Issuer": "UniHome",
    "Audience": "UniHome.Mobile",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Auth": {
    "RateLimit": {
      "IpHashSalt": "",
      "LoginPermitLimit": 10,
      "LoginWindowSeconds": 60,
      "RefreshPermitLimit": 20,
      "RefreshWindowSeconds": 60,
      "ConfirmEmailPermitLimit": 10,
      "ConfirmEmailWindowSeconds": 60,
      "ResendPermitLimit": 5,
      "ResendWindowSeconds": 60,
      "PasswordResetRequestPermitLimit": 5,
      "PasswordResetRequestWindowSeconds": 60,
      "PasswordResetConfirmPermitLimit": 10,
      "PasswordResetConfirmWindowSeconds": 60,
      "DocumentUploadPermitLimit": 10,
      "DocumentUploadWindowSeconds": 60
    }
  },
  "DocumentSecurity": {
    "EncryptionKey": "",
    "CurrentKeyVersion": 1,
    "PreviousEncryptionKeys": [],
    "UrlSigningKey": "",
    "UrlLifetimeSeconds": 300,
    "PublicBaseUrl": ""
  },
  "DocumentAnalysis": {
    "MaxImagePixels": 20000000,
    "ElaJpegQuality": 90,
    "ElaMeanDifferenceThreshold": 8.0,
    "ElaHighDifferenceRatioThreshold": 0.18,
    "ElaHighDifferenceLevel": 24,
    "TesseractExecutablePath": "tesseract",
    "TesseractLanguage": "spa+eng",
    "TesseractTimeoutSeconds": 30,
    "TesseractPageSegmentationMode": 6,
    "PdftoppmExecutablePath": "pdftoppm",
    "PdfRasterTimeoutSeconds": 30,
    "PdfRasterDpi": 200,
    "PdfRasterMaxPages": 3
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "RestUrl": "",
    "RestToken": "",
    "CommandTimeoutMs": 2000,
    "MaxAttempts": 2,
    "RetryDelayMs": 100,
    "ReadinessTimeoutMs": 800,
    "FailureMode": "FailClosed"
  },
  "Proxy": {
    "TrustForwardedHeaders": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Api": {
    "EnableSwagger": false
  },
  "SwaggerAccess": {
    "CookieLifetimeMinutes": 15
  },
  "Admin": {
    "AccountIds": []
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": "",
    "Folder": "unihome/unidades",
    "PublicBaseUrl": "",
    "TimeoutSeconds": 30,
    "UseEphemeralStorage": false
  }
}
