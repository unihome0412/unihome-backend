{
  "stryker-config": {
    "project": "UniHome.Application.csproj",
    "mutate": [
      "**/Identity/Login/LoginService.cs",
      "**/Identity/DeleteAccount/*.cs",
      "**/Identity/PasswordRecovery/*.cs",
      "**/Identity/RefreshSessions/*.cs",
      "**/Favorites/*.cs",
      "**/Units/Photos/*.cs",
      "**/Units/Services/*.cs",
      "**/Units/ZoneRules/*.cs",
      "**/Properties/CreateProperty/*.cs",
      "**/Publications/AcceptTerms/*.cs",
      "**/Publications/SubmitFirstPublication/*.cs",
      "**/Publications/MyPublicationMap/*.cs",
      "**/Profiles/GetProfile/GetProfileService.cs",
      "**/Verification/**/*.cs"
    ],
    "configuration": "Release",
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    },
    "concurrency": 4
  }
}
